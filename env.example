# Copy to .env and fill in your own keys. Never commit .env (see .gitignore).
# Every var below is read directly in src/config.py — kept in sync with that
# file and with render.yaml on purpose, so local dev and prod never diverge
# silently. If you add a new os.getenv(...) in config.py, add it here too.

# --- LLM (Groq primary, up to 5 keys for free-tier rate-limit rotation) ---
# Only GROQ_API_KEY is required; _2.._5 are optional extras.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
# Leave unset to use config.py's own default (openai/gpt-oss-120b) — only
# override if you deliberately want a different model than the code default.
# GROQ_MODEL=

# --- LLM local fallback (used automatically if every Groq key fails) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- News & filings (AI Analyst tab) ---
NEWSAPI_KEY=
FINNHUB_API_KEY=

# --- Macro context (live risk-free rate, 10Y-3M term spread) ---
FRED_API_KEY=

# --- Market data fallback (only used if Yahoo Finance is unreachable) ---
TWELVEDATA_API_KEY=
